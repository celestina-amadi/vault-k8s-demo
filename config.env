# Edit these before running setup.sh
PROJECT_ID="${PROJECT_ID:-project-eff2505d-7601-4d6e-ab6}"
ZONE="${ZONE:-europe-west2-a}"
REGION="${REGION:-${ZONE%-*}}"
NETWORK="${NETWORK:-default}"

CLUSTER_NAME="${CLUSTER_NAME:-vault-demo}"
VAULT_VM_NAME="${VAULT_VM_NAME:-vault-demo-vm}"
SQL_INSTANCE="${SQL_INSTANCE:-vault-demo-mysql}"

# Envoy Gateway, which serves the Vault UI to your browser.
ENVOY_GATEWAY_VERSION="${ENVOY_GATEWAY_VERSION:-v1.4.0}"
# Who may open the Vault UI. Empty = your current public IP. Comma-separated CIDRs otherwise.
VAULT_UI_ALLOWED_CIDRS="${VAULT_UI_ALLOWED_CIDRS:-}"

# Your laptop reaches Vault through an IAP tunnel (./tunnel.sh) on this local port.
VAULT_LOCAL_PORT="${VAULT_LOCAL_PORT:-8200}"
